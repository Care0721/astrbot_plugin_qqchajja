{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "target_groups": {
            "type": "array",
            "description": "监听的QQ群ID列表，留空则监听所有群",
            "items": {"type": "string"},
            "default": []
        },
        "admin_ids": {
            "type": "array",
            "description": "管理员QQ号列表（可执行管理命令）",
            "items": {"type": "string"},
            "default": ["3524815759"]
        },
        "auto_quote_enabled": {
            "type": "boolean",
            "description": "是否开启自动报价",
            "default": false
        },
        "default_template_id": {
            "type": "integer",
            "description": "默认报价模板ID",
            "default": 1
        }
    }
}